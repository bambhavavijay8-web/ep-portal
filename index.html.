<!DOCTYPE html>
<html lang="gu">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EP Management Portal</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --primary: #1e3a8a;
      --primary-light: #3b82f6;
      --secondary: #0d9488;
      --danger: #dc2626;
      --warning: #d97706;
      --bg: #f8fafc;
      --card-bg: #ffffff;
      --text: #0f172a;
      --text-muted: #64748b;
      --border: #e2e8f0;
      --shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }
    body { background-color: var(--bg); color: var(--text); min-height: 100vh; }
    .hidden { display: none !important; }
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
      padding: 0.625rem 1.25rem; font-size: 0.875rem; font-weight: 600; border-radius: 0.5rem;
      border: none; cursor: pointer; transition: all 0.2s ease;
    }
    .btn-primary { background-color: var(--primary); color: white; }
    .btn-primary:hover { background-color: #1e40af; }
    .btn-secondary { background-color: #f1f5f9; color: var(--text); border: 1px solid var(--border); }
    .btn-secondary:hover { background-color: #e2e8f0; }
    .btn-danger { background-color: var(--danger); color: white; }
    .btn-danger:hover { background-color: #b91c1c; }
    .btn-success { background-color: #16a34a; color: white; }
    .btn-warning { background-color: var(--warning); color: white; }
    .btn-sm { padding: 0.35rem 0.75rem; font-size: 0.75rem; border-radius: 0.375rem; }
    .login-container { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 1.5rem; background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%); }
    .login-card { background: white; border-radius: 1rem; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); width: 100%; max-width: 420px; padding: 2.5rem; }
    .form-group { margin-bottom: 1.25rem; }
    .form-label { display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.5rem; color: #334155; }
    .form-input { width: 100%; padding: 0.75rem 1rem; border: 1.5px solid var(--border); border-radius: 0.5rem; font-size: 0.95rem; }
    .form-input:focus { outline: none; border-color: var(--primary-light); }
    .navbar { background: white; border-bottom: 1px solid var(--border); padding: 0.875rem 2rem; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 40; }
    .logo-area { display: flex; align-items: center; gap: 0.75rem; font-size: 1.25rem; font-weight: 700; color: var(--primary); }
    .nav-actions { display: flex; align-items: center; gap: 0.75rem; }
    .user-pill { display: flex; align-items: center; gap: 0.75rem; background: #f8fafc; border: 1px solid var(--border); padding: 0.4rem 0.75rem; border-radius: 9999px; cursor: pointer; }
    .user-avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--primary); color: white; display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 0.875rem; }
    .container { max-width: 1300px; margin: 0 auto; padding: 2rem 1.5rem; }
    .nav-tabs { display: flex; gap: 0.5rem; margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; overflow-x: auto; }
    .tab-btn { padding: 0.75rem 1.25rem; border-radius: 0.5rem; border: none; background: transparent; color: var(--text-muted); font-weight: 600; font-size: 0.95rem; cursor: pointer; display: flex; align-items: center; gap: 0.5rem; }
    .tab-btn.active { background: white; color: var(--primary); box-shadow: var(--shadow); }
    .tab-btn.disabled { opacity: 0.45; cursor: not-allowed; }
    .card { background: white; border-radius: 0.75rem; border: 1px solid var(--border); box-shadow: var(--shadow); padding: 1.5rem; margin-bottom: 1.5rem; }
    .metrics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
    .metric-card { background: white; border: 1px solid var(--border); border-radius: 0.75rem; padding: 1.25rem; display: flex; align-items: center; justify-content: space-between; }
    .metric-val { font-size: 1.75rem; font-weight: 700; margin-top: 0.25rem; }
    .table-container { overflow-x: auto; border: 1px solid var(--border); border-radius: 0.5rem; }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem; }
    th { background: #f8fafc; padding: 0.75rem 1rem; font-weight: 600; color: var(--text-muted); border-bottom: 1px solid var(--border); white-space: nowrap; }
    td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); }
    tr:hover { background-color: #f1f5f9; }
    .badge { padding: 0.25rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; display: inline-flex; align-items: center; }
    .badge-success { background: #dcfce7; color: #166534; }
    .badge-danger { background: #fee2e2; color: #991b1b; }
    .badge-warning { background: #fef3c7; color: #92400e; }
    .drawer-overlay { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.4); z-index: 50; display: flex; justify-content: flex-end; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
    .drawer-overlay.open { opacity: 1; pointer-events: auto; }
    .drawer { width: 100%; max-width: 380px; background: white; height: 100%; padding: 2rem; display: flex; flex-direction: column; transform: translateX(100%); transition: transform 0.3s ease; }
    .drawer-overlay.open .drawer { transform: translateX(0); }
    .modal-overlay { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.5); z-index: 60; display: flex; align-items: center; justify-content: center; padding: 1rem; }
    .modal { background: white; border-radius: 0.75rem; width: 100%; max-width: 500px; padding: 1.5rem; max-height: 90vh; overflow-y: auto; }
  </style>
</head>
<body>

  <!-- PAGE 1: LOGIN -->
  <div id="loginPage" class="login-container">
    <div class="login-card">
      <div style="text-align: center; margin-bottom: 2rem;">
        <i class="fa-solid fa-id-card-clip" style="font-size: 2.5rem; color: var(--primary);"></i>
        <h2 style="margin-top: 0.75rem; font-weight: 700; color: #1e293b;">EP Management Portal</h2>
        <p style="color: var(--text-muted); font-size: 0.875rem;">Admin & Staff Login</p>
      </div>

      <div class="form-group">
        <label class="form-label">Username</label>
        <input type="text" id="loginUsername" class="form-input" placeholder="admin or staff">
      </div>
      <div class="form-group">
        <label class="form-label">Password</label>
        <input type="password" id="loginPassword" class="form-input" placeholder="admin123 or staff123">
      </div>
      <div id="loginError" style="color: var(--danger); font-size: 0.85rem; margin-bottom: 1rem; display: none;">
        અમાન્ય યુઝરનેમ અથવા પાસવર્ડ!
      </div>
      <button class="btn btn-primary" style="width: 100%;" onclick="handleLogin()">
        <i class="fa-solid fa-lock"></i> લૉગિન કરો (Login)
      </button>

      <div style="margin-top: 1.5rem; padding: 0.75rem; background: #f8fafc; border: 1px dashed var(--border); border-radius: 0.5rem; font-size: 0.8rem;">
        <strong>Quick Demo Login:</strong><br>
        Admin: <code>admin</code> / <code>admin123</code><br>
        Staff: <code>staff</code> / <code>staff123</code>
      </div>
    </div>
  </div>

  <!-- PAGE 2: DASHBOARD -->
  <div id="dashboardPage" class="hidden">
    <nav class="navbar">
      <div class="logo-area">
        <i class="fa-solid fa-shield-halved"></i>
        <span>EP Portal</span>
      </div>
      <div class="nav-actions">
        <button class="btn btn-secondary btn-sm" onclick="openSettingsModal()" title="Google Sheet સેટિંગ્સ">
          <i class="fa-solid fa-gear"></i> સેટિંગ્સ
        </button>
        <!-- PULL / REFRESH FROM GOOGLE SHEET BUTTON -->
        <button id="pullBtn" class="btn btn-success btn-sm" onclick="fetchDataFromGoogleSheet()" title="Google Sheet માંથી નવો ડેટા લાવો">
          <i class="fa-solid fa-cloud-arrow-down"></i> Pull Sheet Data
        </button>
        <!-- PUSH TO GOOGLE SHEET BUTTON -->
        <button id="syncBtn" class="btn btn-primary btn-sm" onclick="syncWithGoogleSheet()" title="Google Sheet માં સેવ કરો">
          <i class="fa-solid fa-cloud-arrow-up"></i> Save to Sheet
        </button>
        <div class="user-pill" onclick="toggleProfileDrawer(true)">
          <div class="user-avatar" id="avatarLetter">A</div>
          <div>
            <div style="font-weight: 600; font-size: 0.85rem;" id="navUserName">Admin User</div>
            <div style="font-size: 0.75rem; color: var(--text-muted);" id="navUserRole">Admin</div>
          </div>
        </div>
        <button class="btn btn-danger btn-sm" onclick="handleLogout()">
          <i class="fa-solid fa-arrow-right-from-bracket"></i>
        </button>
      </div>
    </nav>

    <div class="container">
      <div class="nav-tabs">
        <button class="tab-btn active" id="tabOpt1" onclick="switchMainTab(1)">
          <i class="fa-solid fa-chart-pie"></i> 1. EP Status Report
        </button>
        <button class="tab-btn" id="tabOpt2" onclick="switchMainTab(2)">
          <i class="fa-solid fa-file-pen"></i> 2. EP Entry (Admin)
        </button>
        <button class="tab-btn" id="tabOpt3" onclick="switchMainTab(3)">
          <i class="fa-solid fa-receipt"></i> 3. Fine (Admin)
        </button>
        <button class="tab-btn" id="tabOpt4" onclick="switchMainTab(4)">
          <i class="fa-solid fa-key"></i> 4. Change Password
        </button>
      </div>

      <!-- OPTION 1: STATUS REPORT -->
      <div id="viewOption1">
        <div class="metrics-grid">
          <div class="metric-card">
            <div>
              <div style="font-size: 0.85rem; color: var(--text-muted);">Active Passes</div>
              <div class="metric-val" style="color: #16a34a;" id="activePassCount">0</div>
            </div>
            <i class="fa-solid fa-circle-check" style="font-size: 2rem; color: #16a34a; opacity: 0.2;"></i>
          </div>
          <div class="metric-card">
            <div>
              <div style="font-size: 0.85rem; color: var(--text-muted);">Cancel Passes</div>
              <div class="metric-val" style="color: var(--danger);" id="cancelPassCount">0</div>
            </div>
            <i class="fa-solid fa-ban" style="font-size: 2rem; color: var(--danger); opacity: 0.2;"></i>
          </div>
          <div class="metric-card">
            <div>
              <div style="font-size: 0.85rem; color: var(--text-muted);">Total Fine (₹)</div>
              <div class="metric-val" style="color: var(--warning);" id="totalFineAmount">₹0</div>
            </div>
            <i class="fa-solid fa-indian-rupee-sign" style="font-size: 2rem; color: var(--warning); opacity: 0.2;"></i>
          </div>
        </div>

        <div class="card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
            <div style="display: flex; gap: 0.5rem;">
              <button class="btn btn-sm btn-primary" id="btnFilterActive" onclick="setStatusReportFilter('active')">
                1. Active Pass
              </button>
              <button class="btn btn-sm btn-secondary" id="btnFilterCancel" onclick="setStatusReportFilter('cancel')">
                2. Cancel Pass
              </button>
              <button class="btn btn-sm btn-secondary" id="btnFilterFine" onclick="setStatusReportFilter('fine')">
                3. Fine
              </button>
            </div>
            <input type="text" id="reportSearchInput" class="form-input" style="max-width: 250px; padding: 0.4rem 0.75rem;" placeholder="સર્ચ કરો..." oninput="renderReportTable()">
          </div>

          <div class="table-container">
            <table id="statusReportTable">
              <thead id="reportTableHead"></thead>
              <tbody id="reportTableBody"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- OPTION 2: EP ENTRY (ADMIN ONLY) -->
      <div id="viewOption2" class="hidden">
        <div class="card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
            <div>
              <h3 style="font-size: 1.15rem; font-weight: 700;">EP Entry Sheet</h3>
              <p style="font-size: 0.85rem; color: var(--text-muted);">નવો પાસ એન્ટર કરવા માટે Add Row દબાવો. આજની તારીખ આપોઆપ આવી જશે.</p>
            </div>
            <button class="btn btn-primary btn-sm" onclick="addNewEpRow()">
              <i class="fa-solid fa-plus"></i> Add EP Row
            </button>
          </div>
          <div class="table-container">
            <table>
              <thead>
                <tr>
                  <th>Pass No</th>
                  <th>Person Name</th>
                  <th>Contact</th>
                  <th>Vehicle No</th>
                  <th>Entry Date (ઓટો)</th>
                  <th>Status</th>
                  <th>Cancel Date</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="epEntryTableBody"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- OPTION 3: FINE (ADMIN ONLY) -->
      <div id="viewOption3" class="hidden">
        <div class="card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
            <div>
              <h3 style="font-size: 1.15rem; font-weight: 700;">Fine Entry Sheet</h3>
              <p style="font-size: 0.85rem; color: var(--text-muted);">દંડની એન્ટ્રી કરો જે સીધી Option 1 ના Fine ટેબમાં દેખાશે.</p>
            </div>
            <button class="btn btn-primary btn-sm" onclick="addNewFineRow()">
              <i class="fa-solid fa-plus"></i> Add Fine Row
            </button>
          </div>
          <div class="table-container">
            <table>
              <thead>
                <tr>
                  <th>Receipt No</th>
                  <th>Person Name</th>
                  <th>Vehicle No</th>
                  <th>Reason</th>
                  <th>Amount (₹)</th>
                  <th>Fine Date</th>
                  <th>Payment</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="fineEntryTableBody"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- OPTION 4: CHANGE PASSWORD -->
      <div id="viewOption4" class="hidden">
        <div class="card" style="max-width: 500px; margin: 0 auto;">
          <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1rem;">પાસવર્ડ બદલો (Change Password)</h3>
          <div class="form-group">
            <label class="form-label">હાલનો પાસવર્ડ (Current Password)</label>
            <input type="password" id="currentPassInput" class="form-input">
          </div>
          <div class="form-group">
            <label class="form-label">નવો પાસવર્ડ (New Password)</label>
            <input type="password" id="newPassInput" class="form-input">
          </div>
          <div class="form-group">
            <label class="form-label">નવો પાસવર્ડ કન્ફર્મ કરો</label>
            <input type="password" id="confirmPassInput" class="form-input">
          </div>
          <button class="btn btn-primary" onclick="handleChangePassword()">
            <i class="fa-solid fa-check"></i> પાસવર્ડ સેવ કરો
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- PROFILE DRAWER -->
  <div id="profileDrawerOverlay" class="drawer-overlay" onclick="toggleProfileDrawer(false)">
    <div class="drawer" onclick="event.stopPropagation()">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.1rem; font-weight: 700;">સ્ટાફ પ્રોફાઇલ</h3>
        <button class="btn btn-secondary btn-sm" onclick="toggleProfileDrawer(false)"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div style="text-align: center; margin-bottom: 2rem;">
        <div class="user-avatar" style="width: 70px; height: 70px; font-size: 1.75rem; margin: 0 auto 0.75rem;" id="drawerAvatar">A</div>
        <h4 id="drawerName" style="font-size: 1.1rem; font-weight: 700;">-</h4>
        <span class="badge badge-success" id="drawerRoleBadge">Active</span>
      </div>
      <div style="font-size: 0.875rem; display: flex; flex-direction: column; gap: 0.85rem;">
        <div><strong>Staff ID:</strong> <span id="drawerStaffId" style="color: var(--text-muted);">-</span></div>
        <div><strong>Department:</strong> <span id="drawerDept" style="color: var(--text-muted);">-</span></div>
        <div><strong>Shift:</strong> <span id="drawerShift" style="color: var(--text-muted);">-</span></div>
        <div><strong>Contact:</strong> <span id="drawerContact" style="color: var(--text-muted);">-</span></div>
        <div><strong>Email:</strong> <span id="drawerEmail" style="color: var(--text-muted);">-</span></div>
      </div>
    </div>
  </div>

  <!-- GOOGLE SHEETS SETTINGS MODAL -->
  <div id="settingsModal" class="modal-overlay hidden">
    <div class="modal">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="font-weight: 700;">Google Sheets સેટિંગ્સ</h3>
        <button class="btn btn-secondary btn-sm" onclick="closeSettingsModal()"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="form-group">
        <label class="form-label">Google Apps Script Web App URL</label>
        <input type="text" id="scriptUrlInput" class="form-input" placeholder="https://script.google.com/macros/s/.../exec">
      </div>
      <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1.25rem;">
        તમારી Google Apps Script ડિપ્લોયમેન્ટની Web App URL અહીં પેસ્ટ કરીને સેવ કરો.
      </p>
      <button class="btn btn-primary" style="width: 100%;" onclick="saveGoogleScriptUrl()">
        Save & Connect
      </button>
    </div>
  </div>

  <script>
    const INITIAL_USERS = {
      admin: { password: 'admin123', role: 'admin', name: 'સુપર એડમિન (Admin)', staffId: 'EP-ADM-001', dept: 'સુરક્ષા વહીવટ', shift: 'General (9 to 6)', phone: '+91 98765 43210', email: 'admin@portal.com' },
      staff: { password: 'staff123', role: 'staff', name: 'ભાવેશ પંચાલ (Staff)', staffId: 'EP-STF-104', dept: 'મેઇન ગેટ એન્ટ્રી', shift: 'Morning (7 to 3)', phone: '+91 91234 56789', email: 'staff@portal.com' }
    };

    let users = JSON.parse(localStorage.getItem('ep_users')) || INITIAL_USERS;
    let currentUser = null;
    let activeFilter = 'active';

    let epList = JSON.parse(localStorage.getItem('ep_passes_data')) || [
      { id: '1', passNo: 'EP-2026-001', name: 'રમેશભાઈ પટેલ', contact: '98250 11223', vehicle: 'GJ-01-AB-1234', entryDate: '2026-10-25', status: 'Active', cancelDate: '' },
      { id: '2', passNo: 'EP-2026-002', name: 'વિજય શાહ', contact: '94280 44556', vehicle: 'GJ-05-XY-9876', entryDate: '2026-10-24', status: 'Cancel', cancelDate: '2026-10-25' }
    ];

    let fineList = JSON.parse(localStorage.getItem('ep_fine_data')) || [
      { id: '1', receiptNo: 'FN-101', name: 'કિશન દેસાઈ', vehicle: 'GJ-01-QQ-1122', reason: 'હેલ્મેટ / પાસ વગર પ્રવેશ', amount: 500, fineDate: '2026-10-25', status: 'Paid' }
    ];

    function saveState() {
      localStorage.setItem('ep_passes_data', JSON.stringify(epList));
      localStorage.setItem('ep_fine_data', JSON.stringify(fineList));
      localStorage.setItem('ep_users', JSON.stringify(users));
    }

    function getTodayDate() {
      const d = new Date();
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    }

    function handleLogin() {
      const u = document.getElementById('loginUsername').value.trim();
      const p = document.getElementById('loginPassword').value.trim();
      if (users[u] && users[u].password === p) {
        currentUser = { username: u, ...users[u] };
        document.getElementById('loginError').style.display = 'none';
        document.getElementById('loginPage').classList.add('hidden');
        document.getElementById('dashboardPage').classList.remove('hidden');
        setupDashboard();
      } else {
        document.getElementById('loginError').style.display = 'block';
      }
    }

    function handleLogout() {
      currentUser = null;
      document.getElementById('dashboardPage').classList.add('hidden');
      document.getElementById('loginPage').classList.remove('hidden');
    }

    function setupDashboard() {
      document.getElementById('navUserName').innerText = currentUser.name.split(' ')[0];
      document.getElementById('navUserRole').innerText = currentUser.role.toUpperCase();
      document.getElementById('avatarLetter').innerText = currentUser.name.charAt(0);

      const isAdmin = currentUser.role === 'admin';
      const opt2 = document.getElementById('tabOpt2');
      const opt3 = document.getElementById('tabOpt3');

      if (!isAdmin) {
        opt2.classList.add('disabled');
        opt3.classList.add('disabled');
      } else {
        opt2.classList.remove('disabled');
        opt3.classList.remove('disabled');
      }

      switchMainTab(1);
      updateMetrics();
      renderReportTable();

      // Automatically fetch updated data from Google Sheet if URL exists
      if (localStorage.getItem('ep_sheets_url')) {
        fetchDataFromGoogleSheet(true);
      }
    }

    function switchMainTab(num) {
      if ((num === 2 || num === 3) && currentUser.role !== 'admin') {
        alert('આ ઓપ્શનનો એક્સેસ ફક્ત Admin પાસે જ છે!');
        return;
      }
      [1, 2, 3, 4].forEach(i => {
        document.getElementById(`tabOpt${i}`).classList.toggle('active', i === num);
        document.getElementById(`viewOption${i}`).classList.toggle('hidden', i !== num);
      });
      if (num === 1) renderReportTable();
      if (num === 2) renderEpEntryTable();
      if (num === 3) renderFineEntryTable();
    }

    function setStatusReportFilter(filter) {
      activeFilter = filter;
      document.getElementById('btnFilterActive').className = filter === 'active' ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-secondary';
      document.getElementById('btnFilterCancel').className = filter === 'cancel' ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-secondary';
      document.getElementById('btnFilterFine').className = filter === 'fine' ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-secondary';
      renderReportTable();
    }

    function updateMetrics() {
      const activeCount = epList.filter(x => x.status === 'Active').length;
      const cancelCount = epList.filter(x => x.status === 'Cancel').length;
      const fineTotal = fineList.reduce((sum, item) => sum + (Number(item.amount) || 0), 0);

      document.getElementById('activePassCount').innerText = activeCount;
      document.getElementById('cancelPassCount').innerText = cancelCount;
      document.getElementById('totalFineAmount').innerText = `₹${fineTotal.toLocaleString('en-IN')}`;
    }

    function renderReportTable() {
      updateMetrics();
      const head = document.getElementById('reportTableHead');
      const body = document.getElementById('reportTableBody');
      const query = (document.getElementById('reportSearchInput').value || '').toLowerCase();

      if (activeFilter === 'active' || activeFilter === 'cancel') {
        head.innerHTML = `<tr><th>Pass No</th><th>Person Name</th><th>Contact</th><th>Vehicle No</th><th>Entry Date</th><th>Status</th><th>Cancel Date</th></tr>`;
        const targetStatus = activeFilter === 'active' ? 'Active' : 'Cancel';
        const filtered = epList.filter(item => {
          const matchesStatus = item.status === targetStatus;
          const matchesSearch = Object.values(item).some(v => String(v).toLowerCase().includes(query));
          return matchesStatus && matchesSearch;
        });

        if (filtered.length === 0) {
          body.innerHTML = `<tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2rem;">કોઈ ડેટા મળ્યો નથી.</td></tr>`;
          return;
        }

        body.innerHTML = filtered.map(row => `
          <tr>
            <td><strong>${row.passNo || '-'}</strong></td>
            <td>${row.name || '-'}</td>
            <td>${row.contact || '-'}</td>
            <td>${row.vehicle || '-'}</td>
            <td>${row.entryDate || '-'}</td>
            <td><span class="badge ${row.status === 'Active' ? 'badge-success' : 'badge-danger'}">${row.status}</span></td>
            <td>${row.cancelDate || '-'}</td>
          </tr>
        `).join('');
      } else {
        head.innerHTML = `<tr><th>Receipt No</th><th>Person Name</th><th>Vehicle No</th><th>Reason</th><th>Amount (₹)</th><th>Fine Date</th><th>Payment</th></tr>`;
        const filtered = fineList.filter(row => Object.values(row).some(v => String(v).toLowerCase().includes(query)));

        if (filtered.length === 0) {
          body.innerHTML = `<tr><td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2rem;">કોઈ દંડનો ડેટા નથી.</td></tr>`;
          return;
        }

        body.innerHTML = filtered.map(row => `
          <tr>
            <td><strong>${row.receiptNo || '-'}</strong></td>
            <td>${row.name || '-'}</td>
            <td>${row.vehicle || '-'}</td>
            <td>${row.reason || '-'}</td>
            <td>₹${row.amount || 0}</td>
            <td>${row.fineDate || '-'}</td>
            <td><span class="badge ${row.status === 'Paid' ? 'badge-success' : 'badge-danger'}">${row.status}</span></td>
          </tr>
        `).join('');
      }
    }

    function renderEpEntryTable() {
      const body = document.getElementById('epEntryTableBody');
      body.innerHTML = epList.map((row, idx) => `
        <tr>
          <td><input type="text" class="form-input" style="padding: 4px;" value="${row.passNo || ''}" onchange="updateEpItem(${idx}, 'passNo', this.value)"></td>
          <td><input type="text" class="form-input" style="padding: 4px;" value="${row.name || ''}" onchange="updateEpItem(${idx}, 'name', this.value)"></td>
          <td><input type="text" class="form-input" style="padding: 4px;" value="${row.contact || ''}" onchange="updateEpItem(${idx}, 'contact', this.value)"></td>
          <td><input type="text" class="form-input" style="padding: 4px;" value="${row.vehicle || ''}" onchange="updateEpItem(${idx}, 'vehicle', this.value)"></td>
          <td style="white-space: nowrap;">${row.entryDate || ''}</td>
          <td>
            <select class="form-input" style="padding: 4px;" onchange="handleStatusChange(${idx}, this.value)">
              <option value="Active" ${row.status === 'Active' ? 'selected' : ''}>Active</option>
              <option value="Cancel" ${row.status === 'Cancel' ? 'selected' : ''}>Cancel</option>
            </select>
          </td>
          <td>${row.cancelDate || '-'}</td>
          <td>
            ${row.status === 'Active' ? `<button class="btn btn-danger btn-sm" onclick="cancelPass(${idx})">Cancel</button>` : `<span class="badge badge-danger">Cancelled</span>`}
          </td>
        </tr>
      `).join('');
    }

    function addNewEpRow() {
      const newId = String(Date.now());
      const passNumber = `EP-2026-${String(epList.length + 1).padStart(3, '0')}`;
      epList.unshift({
        id: newId,
        passNo: passNumber,
        name: 'નવું નામ',
        contact: '',
        vehicle: '',
        entryDate: getTodayDate(),
        status: 'Active',
        cancelDate: ''
      });
      saveState();
      renderEpEntryTable();
      updateMetrics();
    }

    function cancelPass(idx) {
      epList[idx].status = 'Cancel';
      epList[idx].cancelDate = getTodayDate();
      saveState();
      renderEpEntryTable();
      updateMetrics();
    }

    function handleStatusChange(idx, val) {
      epList[idx].status = val;
      if (val === 'Cancel' && !epList[idx].cancelDate) {
        epList[idx].cancelDate = getTodayDate();
      } else if (val === 'Active') {
        epList[idx].cancelDate = '';
      }
      saveState();
      renderEpEntryTable();
      updateMetrics();
    }

    function updateEpItem(idx, key, val) {
      epList[idx][key] = val;
      saveState();
      updateMetrics();
    }

    function renderFineEntryTable() {
      const body = document.getElementById('fineEntryTableBody');
      body.innerHTML = fineList.map((row, idx) => `
        <tr>
          <td><input type="text" class="form-input" style="padding: 4px;" value="${row.receiptNo || ''}" onchange="updateFineItem(${idx}, 'receiptNo', this.value)"></td>
          <td><input type="text" class="form-input" style="padding: 4px;" value="${row.name || ''}" onchange="updateFineItem(${idx}, 'name', this.value)"></td>
          <td><input type="text" class="form-input" style="padding: 4px;" value="${row.vehicle || ''}" onchange="updateFineItem(${idx}, 'vehicle', this.value)"></td>
          <td><input type="text" class="form-input" style="padding: 4px;" value="${row.reason || ''}" onchange="updateFineItem(${idx}, 'reason', this.value)"></td>
          <td><input type="number" class="form-input" style="padding: 4px; width: 90px;" value="${row.amount || 0}" onchange="updateFineItem(${idx}, 'amount', Number(this.value))"></td>
          <td>${row.fineDate || ''}</td>
          <td>
            <select class="form-input" style="padding: 4px;" onchange="updateFineItem(${idx}, 'status', this.value)">
              <option value="Unpaid" ${row.status === 'Unpaid' ? 'selected' : ''}>Unpaid</option>
              <option value="Paid" ${row.status === 'Paid' ? 'selected' : ''}>Paid</option>
            </select>
          </td>
          <td><button class="btn btn-danger btn-sm" onclick="deleteFineRow(${idx})"><i class="fa-solid fa-trash"></i></button></td>
        </tr>
      `).join('');
    }

    function addNewFineRow() {
      fineList.unshift({
        id: String(Date.now()),
        receiptNo: `FN-${Math.floor(100 + Math.random() * 900)}`,
        name: 'નામ',
        vehicle: '',
        reason: 'નિયમ ભંગ',
        amount: 200,
        fineDate: getTodayDate(),
        status: 'Unpaid'
      });
      saveState();
      renderFineEntryTable();
      updateMetrics();
    }

    function updateFineItem(idx, key, val) {
      fineList[idx][key] = val;
      saveState();
      updateMetrics();
    }

    function deleteFineRow(idx) {
      if (confirm('શું તમે આ દંડ રેકોર્ડ ડિલીટ કરવા માંગો છો?')) {
        fineList.splice(idx, 1);
        saveState();
        renderFineEntryTable();
        updateMetrics();
      }
    }

    function handleChangePassword() {
      const cur = document.getElementById('currentPassInput').value;
      const nxt = document.getElementById('newPassInput').value;
      const cnf = document.getElementById('confirmPassInput').value;

      if (cur !== currentUser.password) {
        alert('હાલનો પાસવર્ડ ખોટો છે!');
        return;
      }
      if (!nxt || nxt.length < 4) {
        alert('નવો પાસવર્ડ ઓછામાં ઓછો 4 અક્ષરનો હોવો જોઈએ!');
        return;
      }
      if (nxt !== cnf) {
        alert('બંને પાસવર્ડ મેચ થતા નથી!');
        return;
      }

      users[currentUser.username].password = nxt;
      currentUser.password = nxt;
      saveState();
      alert('પાસવર્ડ સફળતાપૂર્વક બદલાઈ ગયો છે!');
      document.getElementById('currentPassInput').value = '';
      document.getElementById('newPassInput').value = '';
      document.getElementById('confirmPassInput').value = '';
    }

    function toggleProfileDrawer(open) {
      const el = document.getElementById('profileDrawerOverlay');
      if (open) {
        document.getElementById('drawerName').innerText = currentUser.name;
        document.getElementById('drawerAvatar').innerText = currentUser.name.charAt(0);
        document.getElementById('drawerStaffId').innerText = currentUser.staffId;
        document.getElementById('drawerDept').innerText = currentUser.dept;
        document.getElementById('drawerShift').innerText = currentUser.shift;
        document.getElementById('drawerContact').innerText = currentUser.phone;
        document.getElementById('drawerEmail').innerText = currentUser.email;
        document.getElementById('drawerRoleBadge').innerText = currentUser.role.toUpperCase();
        el.classList.add('open');
      } else {
        el.classList.remove('open');
      }
    }

    function openSettingsModal() {
      document.getElementById('scriptUrlInput').value = localStorage.getItem('ep_sheets_url') || '';
      document.getElementById('settingsModal').classList.remove('hidden');
    }
    function closeSettingsModal() {
      document.getElementById('settingsModal').classList.add('hidden');
    }
    function saveGoogleScriptUrl() {
      const url = document.getElementById('scriptUrlInput').value.trim();
      localStorage.setItem('ep_sheets_url', url);
      closeSettingsModal();
      alert('Google Apps Script URL સેવ થઈ ગઈ છે!');
      fetchDataFromGoogleSheet();
    }

    // 1. PUSH TO GOOGLE SHEETS
    async function syncWithGoogleSheet() {
      const url = localStorage.getItem('ep_sheets_url');
      if (!url) {
        alert('પહેલાં સેટિંગ્સ (Gear Icon) માં જઈને Google Apps Script URL નાખો!');
        openSettingsModal();
        return;
      }
      const btn = document.getElementById('syncBtn');
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
      try {
        await fetch(url, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ epList, fineList })
        });
        alert('Google Sheet માં ડેટા સેવ થઈ ગયો છે!');
      } catch (err) {
        alert('સેવ કરવામાં ભૂલ આવી: ' + err.message);
      } finally {
        btn.innerHTML = '<i class="fa-solid fa-cloud-arrow-up"></i> Save to Sheet';
      }
    }

    // 2. PULL FROM GOOGLE SHEETS (SHEET TO APP)
    async function fetchDataFromGoogleSheet(isSilent = false) {
      const url = localStorage.getItem('ep_sheets_url');
      if (!url) {
        if (!isSilent) {
          alert('પહેલાં સેટિંગ્સમાં Google Sheet URL સેવ કરો!');
          openSettingsModal();
        }
        return;
      }
      const btn = document.getElementById('pullBtn');
      if (!isSilent) btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Fetching...';

      try {
        const response = await fetch(url);
        const data = await response.json();

        if (data && data.success) {
          if (Array.isArray(data.epList) && data.epList.length > 0) {
            epList = data.epList.map(item => ({
              id: item.id || String(Date.now()),
              passNo: item.passNo || '',
              name: item.personName || item.name || '',
              contact: item.contact || '',
              vehicle: item.vehicleNo || item.vehicle || '',
              entryDate: item.entryDate || '',
              status: item.status || 'Active',
              cancelDate: item.cancelDate || ''
            }));
          }

          if (Array.isArray(data.fineList) && data.fineList.length > 0) {
            fineList = data.fineList.map(item => ({
              id: item.id || String(Date.now()),
              receiptNo: item.receiptNo || '',
              name: item.personName || item.name || '',
              vehicle: item.vehicleNo || item.vehicle || '',
              reason: item.reason || '',
              amount: Number(item.amount) || 0,
              fineDate: item.fineDate || '',
              status: item.paymentStatus || item.status || 'Unpaid'
            }));
          }

          saveState();
          updateMetrics();
          renderReportTable();
          renderEpEntryTable();
          renderFineEntryTable();

          if (!isSilent) {
            alert('Google Sheet માંથી નવો ડેટા સફળતાપૂર્વક એપમાં આવી ગયો છે!');
          }
        }
      } catch (err) {
        console.error("Fetch error:", err);
        if (!isSilent) {
          alert('Google Sheet માંથી ડેટા લાવવામાં ભૂલ આવી. ખાતરી કરો કે Apps Script માં Who has access = Anyone સિલેક્ટ કરેલું છે.');
        }
      } finally {
        if (!isSilent) btn.innerHTML = '<i class="fa-solid fa-cloud-arrow-down"></i> Pull Sheet Data';
      }
    }
  </script>
</body>
</html>
